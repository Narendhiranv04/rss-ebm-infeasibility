+def witnesses(run):
+    nver = dist = files = 0
+    per = []
+    for h, q, m, a in K.load(run):
+        if q["eligible"] and q["completed"]:
+            ids = [str(w) for v, w in zip(a["a_verified"], a["a_witness"]) if v]
