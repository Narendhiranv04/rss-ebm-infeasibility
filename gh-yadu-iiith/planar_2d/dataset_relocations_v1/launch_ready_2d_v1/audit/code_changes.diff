+    assert r["label"] == old["label"] and {k: r["mode_counts"][k] for k in old["mode_summary"]} == old["mode_summary"]
+    assert [(a["pick"], a["place"]) for a in old["attempts"]] == list(zip(z["a_pick"].tolist(), z["a_place"].tolist()))
