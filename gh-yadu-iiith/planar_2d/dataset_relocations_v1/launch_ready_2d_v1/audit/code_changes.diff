+        st, path, method, work = P.plan_carry(cks[i][("held", False)], a.q_end, b.q_end, a.gap, cfg, p, f"{rec['trial_id']}/carry{i}.{j}", guide, pose)
+        ok, w, keep = False, "", False
+        if st == ge.CLEAR:
