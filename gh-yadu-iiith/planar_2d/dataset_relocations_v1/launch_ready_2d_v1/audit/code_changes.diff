+    monkeypatch.setattr(P, "plan_carry", lambda *a, **k: pytest.fail("planner called"))
+    monkeypatch.setattr(R, "run", lambda *a, **k: pytest.fail("runner started"))
+    target = Path(R.cfg_of(L)["full_run_dir"])
