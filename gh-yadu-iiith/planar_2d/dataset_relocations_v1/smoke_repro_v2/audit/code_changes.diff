+    b = next(c for c in P.sk.screen_place(robot, ck, dxy, a.local, a.gap, p) if c.stage == "OK")
+    st, path, method, work = P.plan_carry(ck[("held", False)], a.q_end, b.q_end, a.gap, G["cfg"], p, "unit/det")
